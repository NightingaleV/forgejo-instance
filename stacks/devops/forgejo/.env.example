# Forgejo + Actions runner environment
# These values are managed in Komodo for this stack (see stacks.toml). This file
# is documentation-only; do not store real secrets here.

# --- Forgejo server ---
FORGEJO_DOMAIN=git.slavik.tech
FORGEJO_ROOT_URL=https://git.slavik.tech/
FORGEJO_SSH_DOMAIN=git.slavik.tech
FORGEJO_SSH_PORT=222

# --- Database ---
FORGEJO_DB_NAME=forgejo
FORGEJO_DB_USER=forgejo
FORGEJO_DB_PASS=change-me

# --- Actions runner registration ---
# Get a fresh token from: Forgejo UI (Site Administration -> Actions -> Runners
# -> Create new runner) OR via the API:
#   curl -s -H "Authorization: token $FORGEJO_PAT" \
#     https://git.slavik.tech/api/v1/user/actions/runners/registration-token
FORGEJO_RUNNER_TOKEN=change-me
FORGEJO_RUNNER_NAME=homelab-runner-01

# --- Shared ---
DOCKER_VOLUME_STORAGE=/srv/appdata
TZ=Europe/Prague